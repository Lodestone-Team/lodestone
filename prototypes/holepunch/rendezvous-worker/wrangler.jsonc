// The holepunch prototype's introduction service on Cloudflare Workers: the same
// protocol as `holepunch rendezvous` (see ../src/rendezvous.rs), over HTTPS.
// Each invite is one Durable Object holding the host's addresses and its joins.
{
  "name": "lodestone-rendezvous",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "SESSIONS", "class_name": "Session" }]
  },
  // SQLite-backed Durable Objects, which the Workers Free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }]
}
